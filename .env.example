# Flask Server Configuration
PORT=5000

# --- Security (REQUIRED) ---
# 4-digit staff PIN shown on the login screen of every new device
APP_PIN=1234
# Long random secret used as the device token.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_TOKEN_SECRET=change_me_to_a_long_random_string

# Base directory for saving output Excel files and logs (Default: Desktop)
# APP_BASE_DIR=C:\Users\username\Desktop

# --- Firebird Database Configuration (Akinsoft Wolvox) ---
DB_HOST=127.0.0.1
DB_PORT=3050
DB_PATH=C:\AKINSOFT\Wolvox8\Database_FB\100\2026\wolvox.fdb
# Strongly recommended: a dedicated READ-ONLY Firebird user instead of SYSDBA
DB_USER=SYSDBA
DB_PASSWORD=your_database_password_here
DB_CHARSET=WIN1254
